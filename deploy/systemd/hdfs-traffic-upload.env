# /etc/default/hdfs-traffic-upload: options of upload-events.sh for the systemd service.
# -d events dir (the agent's events= directory), -r HDFS root, -k/-p keytab and principal
# (omit both without Kerberos), -H node key (default hostname -f), -b files per put.
# systemd < 229 (RHEL/CentOS 7) ignores RandomizedDelaySec in the timer: add -j 240 here.
UPLOAD_ARGS="-d /var/log/hadoop/hdfs-traffic -r /data/hdfs-traffic/raw -k /etc/security/keytabs/hdfs.headless.keytab -p hdfs@EXAMPLE.COM"
# JAVA_HOME=/usr/lib/jvm/java
# HADOOP_CLIENT_OPTS=-Xmx256m
